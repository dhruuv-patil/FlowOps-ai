{
  "slug": "crm-billing-reconciliation",
  "name": "CRM \u2194 Billing Reconciliation",
  "description": "Reconcile customer and billing records, classify discrepancies, and gate corrective updates through approval.",
  "category": "RevOps/Sales",
  "icon": "ArrowLeftRight",
  "tags": [
    "crm",
    "billing",
    "reconciliation",
    "data-quality"
  ],
  "providers": [
    "salesforce",
    "stripe",
    "database",
    "slack"
  ],
  "graph": {
    "nodes": [
      {
        "id": "trigger",
        "type": "schedule_trigger",
        "position": {
          "x": 80,
          "y": 220
        },
        "data": {
          "label": "Reconciliation run",
          "config": {
            "cron": "0 2 * * *",
            "timezone": "UTC"
          }
        }
      },
      {
        "id": "crm",
        "type": "database_query",
        "position": {
          "x": 360,
          "y": 80
        },
        "data": {
          "label": "Load CRM accounts",
          "config": {
            "databaseType": "postgresql",
            "host": "{{DATABASE_HOST}}",
            "database": "flowops",
            "username": "{{DATABASE_USER}}",
            "password": "{{DATABASE_PASSWORD}}",
            "sql": "SELECT * FROM crm_accounts WHERE active = true"
          }
        }
      },
      {
        "id": "billing",
        "type": "database_query",
        "position": {
          "x": 360,
          "y": 360
        },
        "data": {
          "label": "Load billing accounts",
          "config": {
            "databaseType": "postgresql",
            "host": "{{DATABASE_HOST}}",
            "database": "flowops",
            "username": "{{DATABASE_USER}}",
            "password": "{{DATABASE_PASSWORD}}",
            "sql": "SELECT * FROM billing_accounts WHERE active = true"
          }
        }
      },
      {
        "id": "reconcile",
        "type": "ai_agent",
        "position": {
          "x": 640,
          "y": 220
        },
        "data": {
          "label": "Reconcile CRM and billing",
          "config": {
            "instructions": "Reconcile CRM and billing records and return strict JSON with has_discrepancies true or false, evidence, and proposed corrections.",
            "input": "CRM={{crm.results}} Billing={{billing.results}}"
          }
        }
      },
      {
        "id": "gate",
        "type": "router",
        "position": {
          "x": 920,
          "y": 220
        },
        "data": {
          "label": "Reconciliation result",
          "config": {
            "input": "{{reconcile.output}}",
            "routes": [
              "(?s).*\"has_discrepancies\"\\s*:\\s*true.*",
              "(?s).*\"has_discrepancies\"\\s*:\\s*false.*"
            ]
          }
        }
      },
      {
        "id": "approval",
        "type": "human_approval",
        "position": {
          "x": 1200,
          "y": 80
        },
        "data": {
          "label": "Approve corrections",
          "config": {
            "prompt": "Review reconciliation discrepancies and approve the proposed corrections."
          }
        }
      },
      {
        "id": "update",
        "type": "database_update",
        "position": {
          "x": 1480,
          "y": 80
        },
        "data": {
          "label": "Apply CRM/billing correction",
          "config": {
            "databaseType": "postgresql",
            "host": "{{DATABASE_HOST}}",
            "database": "flowops",
            "username": "{{DATABASE_USER}}",
            "password": "{{DATABASE_PASSWORD}}",
            "sql": "UPDATE reconciliation_queue SET status='APPROVED', approved_at=NOW() WHERE run_id='{{trigger.timestamp}}'"
          }
        }
      },
      {
        "id": "incident",
        "type": "incident_creator",
        "position": {
          "x": 1480,
          "y": 360
        },
        "data": {
          "label": "Create reconciliation task",
          "config": {
            "title": "CRM to billing mismatch",
            "severity": "MEDIUM",
            "body": "{{reconcile.output}}",
            "channel": "slack"
          }
        }
      },
      {
        "id": "notify",
        "type": "notification",
        "position": {
          "x": 1760,
          "y": 220
        },
        "data": {
          "label": "Reconciliation summary",
          "config": {
            "channel": "slack",
            "message": "CRM \u2194 billing reconciliation completed.\n{{reconcile.output}}"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-crm",
