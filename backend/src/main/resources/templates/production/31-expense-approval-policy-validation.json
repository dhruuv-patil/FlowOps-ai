{
  "slug": "expense-approval-policy-validation",
  "name": "Expense Approval with Policy Validation",
  "description": "Validate expenses against policy and confidence thresholds, require approval for exceptions, and audit the final decision.",
  "category": "Business Operations",
  "icon": "ReceiptText",
  "tags": [
    "expense",
    "policy",
    "approval",
    "audit"
  ],
  "providers": [
    "ai",
    "database",
    "slack"
  ],
  "graph": {
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_trigger",
        "position": {
          "x": 80,
          "y": 220
        },
        "data": {
          "label": "Expense submitted",
          "config": {
            "method": "POST"
          }
        }
      },
      {
        "id": "dedupe",
        "type": "idempotency_check",
        "position": {
          "x": 360,
          "y": 220
        },
        "data": {
          "label": "Deduplicate expense",
          "config": {
            "key": "{{trigger.body.expenseId}}"
          }
        }
      },
      {
        "id": "policy",
        "type": "ai_agent",
        "position": {
          "x": 640,
          "y": 220
        },
        "data": {
          "label": "Validate expense policy",
          "config": {
            "instructions": "Validate the expense against policy and return strict JSON with compliant true or false, confidence, violations, and recommended action.",
            "input": "{{trigger.body}}"
          }
        }
      },
      {
        "id": "gate",
        "type": "router",
        "position": {
          "x": 920,
          "y": 220
        },
        "data": {
          "label": "Policy result",
          "config": {
            "input": "{{policy.output}}",
            "routes": [
              "(?s).*\"compliant\"\\s*:\\s*true.*",
              "(?s).*\"compliant\"\\s*:\\s*false.*"
            ]
          }
        }
      },
      {
        "id": "approval",
        "type": "human_approval",
        "position": {
          "x": 1200,
          "y": 80
        },
        "data": {
          "label": "Approve exception",
          "config": {
            "prompt": "Review the expense and policy violations before approving an exception."
          }
        }
      },
      {
        "id": "pay",
        "type": "http_request",
        "position": {
          "x": 1480,
          "y": 80
        },
        "data": {
          "label": "Submit payment",
          "config": {
            "method": "POST",
            "url": "https://payments.example/v1/expenses/pay",
            "body": "{{trigger.body}}"
          }
        }
      },
      {
        "id": "flag",
        "type": "notification",
        "position": {
          "x": 1200,
          "y": 360
        },
        "data": {
          "label": "Flag for review",
          "config": {
            "channel": "slack",
            "message": "Expense {{trigger.body.expenseId}} requires review.\n{{policy.output.violations}}"
          }
        }
      },
      {
        "id": "audit",
        "type": "database_insert",
        "position": {
          "x": 1760,
          "y": 220
        },
        "data": {
          "label": "Audit expense decision",
          "config": {
            "databaseType": "postgresql",
            "host": "{{DATABASE_HOST}}",
            "database": "flowops",
            "username": "{{DATABASE_USER}}",
            "password": "{{DATABASE_PASSWORD}}",
            "sql": "INSERT INTO expense_audit (expense_id, decision, payload, created_at) VALUES ('{{trigger.body.expenseId}}','{{policy.output.compliant}}','{{policy.output}}',NOW())"
          }
        }
      },
      {
        "id": "notify",
        "type": "notification",
        "position": {
          "x": 2040,
          "y": 220
        },
        "data": {
          "label": "Expense result",
          "config": {
            "channel": "slack",
            "message": "Expense {{trigger.body.expenseId}} processing completed."
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-dedupe",
        "source": "trigger",
        "target": "dedupe",
        "sourceHandle": null
      },
      {
        "id": "e-dedupe-policy",
        "source": "dedupe",
        "target": "policy",
        "sourceHandle": null
      },
      {
        "id": "e-policy-gate",
        "source": "policy",
        "target": "gate",
        "sourceHandle": null
      },
      {
        "id": "e-gate-pay-true",
        "source": "gate",
        "target": "pay",
        "sourceHandle": "route1"
      },
      {
        "id": "e-gate-approval-false",
        "source": "gate",
        "target": "approval",
        "sourceHandle": "route2"
      },
      {
        "id": "e-approval-pay-approved",
        "source": "approval",
        "target": "pay",
        "sourceHandle": "approved"
      },
      {
        "id": "e-approval-flag-rejected",
        "source": "approval",
        "target": "flag",
        "sourceHandle": "rejected"
      },
      {
        "id": "e-pay-audit",
        "source": "pay",
        "target": "audit",
        "sourceHandle": null
      },
      {
        "id": "e-flag-audit",
        "source": "flag",
        "target": "audit",
        "sourceHandle": null
      },
      {
        "id": "e-audit-notify",
        "source": "audit",
        "target": "notify",
        "sourceHandle": null
      }
    ]
  }
}
