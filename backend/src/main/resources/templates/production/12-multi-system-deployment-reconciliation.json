{
  "slug": "multi-system-deployment-reconciliation",
  "name": "Multi-System Deployment Reconciliation",
  "description": "Compare deployment, incident, and observability state and gate corrective actions until evidence is reviewed.",
  "category": "Reliability/Incident Management",
  "icon": "GitPullRequestArrow",
  "tags": [
    "reconciliation",
    "deployments",
    "incidents",
    "observability"
  ],
  "providers": [
    "slack"
  ],
  "graph": {
    "nodes": [
      {
        "id": "trigger",
        "type": "manual_trigger",
        "position": {
          "x": 80,
          "y": 220
        },
        "data": {
          "label": "Start reconciliation",
          "config": {}
        }
      },
      {
        "id": "deploy",
        "type": "http_request",
        "position": {
          "x": 360,
          "y": 80
        },
        "data": {
          "label": "Fetch deployment state",
          "config": {
            "method": "GET",
            "url": "https://deploy.example/v1/state"
          }
        }
      },
      {
        "id": "incident",
        "type": "http_request",
        "position": {
          "x": 360,
          "y": 220
        },
        "data": {
          "label": "Fetch incident state",
          "config": {
            "method": "GET",
            "url": "https://incidents.example/v1/state"
          }
        }
      },
      {
        "id": "monitor",
        "type": "http_request",
        "position": {
          "x": 360,
          "y": 360
        },
        "data": {
          "label": "Fetch observability state",
          "config": {
            "method": "GET",
            "url": "https://observability.example/v1/state"
          }
        }
      },
      {
        "id": "reconcile",
        "type": "ai_agent",
        "position": {
          "x": 640,
          "y": 220
        },
        "data": {
          "label": "Reconcile system state",
          "config": {
            "instructions": "Reconcile deployment, incident, and observability state and return strict JSON with inconsistent exactly true or false, evidence, and a safe correction plan.",
            "input": "Deployment={{deploy.body}} Incident={{incident.body}} Observability={{monitor.body}}"
          }
        }
      },
      {
        "id": "gate",
        "type": "router",
        "position": {
          "x": 920,
          "y": 220
        },
        "data": {
          "label": "Reconciliation result",
          "config": {
            "input": "{{reconcile.output}}",
            "routes": [
              "(?s).*\"inconsistent\"\\s*:\\s*true.*",
              "(?s).*\"inconsistent\"\\s*:\\s*false.*"
            ]
          }
        }
      },
      {
        "id": "approval",
        "type": "human_approval",
        "position": {
          "x": 1200,
          "y": 80
        },
        "data": {
          "label": "Approve state correction",
          "config": {
            "prompt": "Review the reconciliation evidence before changing system-of-record state."
          }
        }
      },
      {
        "id": "correct",
        "type": "http_request",
        "position": {
          "x": 1480,
          "y": 80
        },
        "data": {
          "label": "Apply correction",
          "config": {
            "method": "POST",
            "url": "https://deploy.example/v1/reconcile",
            "body": "{{reconcile.output.plan}}"
          }
        }
      },
      {
        "id": "verify",
        "type": "health_check",
        "position": {
          "x": 1760,
          "y": 80
        },
        "data": {
          "label": "Verify convergence",
          "config": {
            "checks": [
              {
                "path": "correct.body.status",
                "op": "==",
                "value": "converged"
              }
            ]
          }
        }
      },
      {
        "id": "incident_create",
        "type": "incident_creator",
        "position": {
          "x": 1480,
          "y": 360
        },
        "data": {
          "label": "Create reconciliation incident",
          "config": {
            "title": "Cross-system deployment state mismatch",
            "severity": "HIGH",
            "body": "{{reconcile.output}}",
            "channel": "slack"
          }
        }
      },
      {
        "id": "notify",
        "type": "notification",
        "position": {
          "x": 2040,
          "y": 220
        },
        "data": {
          "label": "Reconciliation summary",
          "config": {
            "channel": "slack",
            "message": "Reconciliation completed.\n{{reconcile.output}}"
          }
        }
      }
    ],
    "edges": [
